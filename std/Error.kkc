export panic, todo, unreachable, panic', assert, Failable(*), or-fail, *

use Cnile
use Mem
use Iter
	for-each
use StrInst (Str(*))
use Prim
	panic, todo, unreachable, assert, println
	Failable(*), or-fail


fn todo'(s Str) -> a
	println('todo: \(s)')
	Cnile.abort()
	return Mem.undefined()

fn panic' (errmsg) -> a
	println('PANIC: \(errmsg)')
	Cnile.abort()
	return Mem.undefined()


### Failable

inst Failable Either
	try-get-value (x _): (case x)
		Right(v): Just(v)
		_: None
	

fn or-else (self, alt)
	case self try-get-value()
		None
			return alt
		Just(xx)
			return xx

