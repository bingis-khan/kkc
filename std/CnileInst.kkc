use Cnile
	Timespec

inst Ord Timespec
	cmp (l, r)
		ls = l.tv-sec
		rs = r.tv-sec

		if ls > rs
			return GT
		elif ls < rs
			return LT
		else
			ln = l.tv-nsec
			rn = r.tv-nsec

			if ln > rn
				return GT
			elif ln < rn
				return LT
			else
				return EQ



DIRIter
	og Ptr Cnile.DIR

inst Iter DIRIter
	next (self Ptr _) -> Maybe (Ptr Cnile.Dirent)
		return Cnile.readdir(self&.og) Mem.castptr-ptr()

inst IntoIter DIRIter
	into-iter (self _): self


fn consooming-c-dir-iter(dir Ptr Cnile.DIR) -> DIRIter: { og: dir }
